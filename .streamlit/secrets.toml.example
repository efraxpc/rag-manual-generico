# Copia como .streamlit/secrets.toml. Ese archivo está excluido de Git.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "<secreto-aleatorio-generado-para-las-cookies>"
expose_tokens = ["access"]

[auth.microsoft]
client_id = "<client-id-del-registro-streamlit>"
client_secret = "<secreto-del-registro-streamlit>"
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email api://<client-id-del-registro-api>/access_as_user", prompt = "select_account" }
