APP_APP_NAME="RAG Manual API"
APP_APP_VERSION="0.1.0"
APP_ENVIRONMENT="development"
APP_DEBUG=false
APP_DOCS_ENABLED=true
APP_API_V1_PREFIX="/api/v1"
APP_API_BASE_URL="http://localhost:8000"
APP_CORS_ORIGINS='["http://localhost:3000"]'

# Para cargar archivos como texto, configura el endpoint y el índice textual.
# APP_AZURE_SEARCH_ENDPOINT="https://<servicio>.search.windows.net"
# APP_AZURE_SEARCH_TEXT_INDEX_NAME="rag-text-chunks"

# Opcional: habilita las operaciones vectoriales con el mismo endpoint.
# Configura nombre y dimensiones conjuntamente, usando un índice distinto.
# Las dimensiones deben coincidir con el modelo de embeddings y el índice.
# APP_AZURE_SEARCH_INDEX_NAME="rag-chunks"
# APP_AZURE_SEARCH_VECTOR_DIMENSIONS=1536

# Autenticación delegada de FastAPI: configura las cuatro variables conjuntamente.
# Los IDs son UUID. El secreto pertenece al registro de la API, no al frontend.
# APP_ENTRA_TENANT_ID="<tenant-id>"
# APP_ENTRA_API_CLIENT_ID="<client-id-api>"
# APP_ENTRA_API_CLIENT_SECRET="<secreto-api>"
# APP_ENTRA_FRONTEND_CLIENT_ID="<client-id-streamlit>"

# Solo para el comando administrativo prepare_text_index en Azure.
# Las peticiones HTTP usan exclusivamente la identidad del usuario mediante OBO.
# APP_AZURE_MANAGED_IDENTITY_CLIENT_ID="<client-id>"
