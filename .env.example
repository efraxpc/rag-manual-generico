APP_APP_NAME="RAG Manual API"
APP_APP_VERSION="0.1.0"
APP_ENVIRONMENT="development"
APP_DEBUG=false
APP_DOCS_ENABLED=true
APP_API_V1_PREFIX="/api/v1"
APP_API_BASE_URL="http://localhost:8000"
APP_CORS_ORIGINS='["http://localhost:3000"]'

# Habilita Azure AI Search configurando las tres variables conjuntamente.
# Las dimensiones deben coincidir con el modelo de embeddings y el índice.
# APP_AZURE_SEARCH_ENDPOINT="https://<servicio>.search.windows.net"
# APP_AZURE_SEARCH_INDEX_NAME="rag-chunks"
# APP_AZURE_SEARCH_VECTOR_DIMENSIONS=1536

# Client ID de la identidad administrada asignada a Container Apps.
# En desarrollo, DefaultAzureCredential puede utilizar la sesión de az login.
# APP_AZURE_MANAGED_IDENTITY_CLIENT_ID="<client-id>"
