# Copia este archivo como terraform.tfvars y ajusta solo lo necesario.
# Dejar estos IDs en null utiliza el tenant y la suscripción activos de Azure CLI.
subscription_id = null
tenant_id       = null

project_name = "rag-manual-generico"
environment  = "dev"
location     = "brazilsouth"

key_vault_sku_name            = "standard"
grant_deployer_secrets_access = true

# Recursos del despliegue existente de Azure Container Apps.
container_apps_resource_group_name = "rg-fastapi-hello"
container_registry_name             = "fastapihellowkiksu"
log_analytics_workspace_name        = "workspace-rgfastapihellovmC5"
container_app_environment_name      = "cae-rag-manual-dev"
container_app_identity_name         = "id-rag-manual-dev"
container_app_name                  = "rag-manual-api"
container_image_repository          = "rag-manual-api"
container_image_tag                 = "ce4ae6b"

container_app_environment  = "production"
container_app_target_port  = 8000
container_app_cpu          = 0.5
container_app_memory       = "1Gi"
container_app_min_replicas = 0
container_app_max_replicas = 3

# Generación RAG de FastAPI. Configura ambos valores o conserva ambos en null.
# El juez se ejecuta en CI y no se configura dentro de la Container App.
azure_openai_endpoint        = null
azure_openai_chat_deployment = null

# Azure AI Search. null genera un nombre global estable para la suscripción.
search_service_name = null
search_service_sku  = "free"
# Grupo cuyos usuarios accederán a Search mediante On-Behalf-Of.
# Usa el Object ID del grupo, no su nombre ni el Object ID de un usuario.
search_user_group_object_id = null

# Autenticación delegada. Mantén null hasta crear los dos registros de aplicación.
# Pasa el secreto mediante TF_VAR_entra_api_client_secret para no escribirlo aquí.
entra_tenant_id         = null
entra_api_client_id     = null
entra_frontend_client_id = null

# Agrega las IP públicas autorizadas como rangos /32 o CIDR corporativos.
# Con la lista vacía, el plano de datos permanece bloqueado desde Internet.
allowed_ip_cidrs = [
  # "203.0.113.10/32",
]

tags = {
  Owner = "equipo-rag"
}
