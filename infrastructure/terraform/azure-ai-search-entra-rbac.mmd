flowchart LR
  terraform["Terraform<br/>search.tf"]

  subgraph frontend["Streamlit"]
    user["Usuario conectado"]
    access_token["Token para FastAPI<br/>scope: access_as_user"]
  end

  subgraph workload["Azure Container Apps"]
    app["RAG Manual API"]
    managed_identity["User Assigned Managed Identity<br/>solo ACR Pull"]
  end

  subgraph entra_boundary["Microsoft Entra ID"]
    frontend_app["Registro de aplicación<br/>Streamlit"]
    api_app["Registro de aplicación<br/>FastAPI confidencial"]
    obo["Flujo On-Behalf-Of"]
    group["Grupo autorizado de usuarios"]
  end

  subgraph rbac_boundary["Azure RBAC"]
    role_assignment["Search Index Data Contributor<br/>Scope: servicio Search"]
  end

  subgraph search_boundary["Azure AI Search"]
    search_service["Servicio Search<br/>claves deshabilitadas"]
    documents["Documentos de los índices"]
  end

  user -->|"1. Login OIDC"| frontend_app
  frontend_app -->|"2. Emite"| access_token
  access_token -->|"3. Authorization: Bearer"| app
  app -->|"4. Valida firma, tenant, audiencia, azp y scope"| api_app
  app -->|"5. Intercambia token"| obo
  api_app --> obo
  obo -->|"6. Token de Search del usuario"| app
  app -->|"7. HTTPS + token delegado"| search_service
  group -->|"Usuario miembro"| user
  group --> role_assignment
  role_assignment --> search_service
  search_service --> documents

  terraform --> search_service
  terraform --> role_assignment
  managed_identity -.->|"No participa en las peticiones a Search"| search_service

