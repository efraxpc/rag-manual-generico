  owner["Propietario de contenido<br/>Equipajes, estaciones o legal"]
  sources["Manuales de equipaje · SOP de estación<br/>Acuerdos interlínea · políticas de compensación"]
  ui["Azure Container Apps<br/>Portal de administración"]
  api["FastAPI · validar identidad,<br/>rol y ámbito documental"]
  validate["Validar archivo, propietario,<br/>checksum, idioma y clasificación"]
  governance{"¿Documento aprobado,<br/>vigente y versionado?"}
  rejected["Cuarentena<br/>No disponible para el agente"]
  document_id["Calcular document_id<br/>Hash estable e idempotente"]
  blob[("Azure Storage<br/>Original inmutable + metadatos")]
  queue[["Azure Service Bus<br/>Publicar trabajo"]]
  worker["Azure Container Apps<br/>Worker de ingesta"]
  format{"¿Necesita OCR,<br/>tablas o estructura?"}
  local["Extracción local<br/>PDF con texto, TXT y Markdown"]
  intelligence["Azure AI Document Intelligence<br/>OCR, tablas y estructura"]
  normalize["Normalizar secciones, pasos,<br/>tablas y números de página"]
  output["Salida normalizada<br/>Texto + estructura + procedencia"]

  title --> azure_services
  azure_services --> owner
  owner --> sources
  sources --> ui
  ui -->|"Archivo + ficha documental"| api
  api --> validate
  validate --> governance
  governance -->|"No"| rejected
  governance -->|"Sí"| document_id
  document_id --> blob
  document_id --> queue
  queue --> worker
  worker -->|"Leer"| blob
  worker --> format
  format -->|"No"| local
  format -->|"Sí"| intelligence
  local --> normalize
  intelligence --> normalize
  normalize --> output

  next["Continuar con 6/8:<br/>Chunking e indexación con vigencia"]
  output --> next
  privacy["No indexar PNR, etiquetas, nombres<br/>ni datos transaccionales de pasajeros."]
  privacy -.-> validate
  error["Error recuperable:<br/>reintento limitado y luego DLQ"]
  worker -->|"Fallo"| error
  error --> queue

