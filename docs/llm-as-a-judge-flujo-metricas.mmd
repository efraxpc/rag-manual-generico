  scenarios --> seed
  corpus --> seed
  seed --> retrieve --> generator --> answers
  scenarios -. "Conserva expectativas" .-> answers

  answers --> judge_code --> azure_judge
  azure_judge --> groundedness
  azure_judge --> relevance
  azure_judge --> completeness
  azure_judge --> citations
  groundedness --> structured
  relevance --> structured
  completeness --> structured
  citations --> structured
  structured --> local_gate
  local_gate -->|"No"| stop_quality
  local_gate -->|"Sí"| deploy

  scope_note -.-> answers
  calibration -. "Mejora futura: comparar notas del juez<br/>contra etiquetas humanas" .-> azure_judge

