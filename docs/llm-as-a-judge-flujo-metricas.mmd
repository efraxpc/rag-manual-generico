flowchart TB
  %% Relación entre los datasets, el RAG candidato, las métricas del juez y CI/CD.

  title["<b>Evaluation dataset + LLM-as-a-judge</b><br/>Qué se evalúa y dónde interviene cada métrica"]
  execution["Ejecución local o pipeline CI/CD"]

  subgraph technical["1. Validación técnica determinista"]
    tests["<code>pytest</code><br/>Tests unitarios, API y manejo de errores"]
    ruff["<code>ruff check</code> + <code>ruff format --check</code><br/>Lint, imports, errores comunes y formato"]
    technical_gate{"¿Tests y Ruff pasan?"}
  end

  subgraph dataset["2. Evaluation dataset versionado"]
    scenarios[("<code>rag_scenarios.jsonl</code><br/>pregunta · expected_answer<br/>expected_sources · documento · top_k")]
    corpus[("<code>evaluations/corpus/</code><br/>Manuales controlados")]
  end

  subgraph candidate["3. Ejecución del RAG candidato"]
    seed["Indexar el corpus en<br/>Azure AI Search de evaluación"]
    retrieve["Recuperar contexto relevante"]
    generator["Azure OpenAI<br/>Deployment generador"]
    answers[("<code>candidate-answers.jsonl</code><br/>pregunta · respuesta generada · contexto<br/>respuesta esperada · fuentes esperadas")]
  end

  subgraph evaluation["4. Evaluación LLM-as-a-judge"]
    judge_code["<code>LlmJudge</code><br/>Construye el caso y la rúbrica <code>rag-judge-v1</code>"]
    azure_judge["Azure OpenAI<br/>Deployment juez<br/><i>La puntuación puede variar</i>"]

    groundedness["<b>groundedness</b><br/>¿Las afirmaciones están respaldadas<br/>por el contexto recuperado?"]
    relevance["<b>relevance</b><br/>¿La respuesta contesta directamente<br/>la pregunta?"]
    completeness["<b>completeness</b><br/>¿Cubre la información necesaria y<br/>la respuesta esperada?"]
    citations["<b>citation_quality</b><br/>¿Las citas corresponden con<br/>las fuentes y páginas?"]

    structured["Structured Output<br/>Notas 1..5 · razones<br/>unsupported_claims · missing_information"]
    local_gate{"Gate calculado en Python<br/>¿Todas las notas ≥ 4<br/>y sin unsupported_claims?"}
  end

  stop_technical["Pipeline fallido<br/>No se evalúa ni despliega"]
  stop_quality["Calidad RAG insuficiente<br/>No se despliega"]
  deploy["Construir imagen y desplegar<br/>el commit aprobado"]

  scope_note["<b>Alcance actual</b><br/>El dataset mide el RAG candidato;<br/>no mide la precisión del modelo juez"]
  calibration["<b>Para calibrar al juez</b><br/>Dataset gold revisado por humanos con respuestas<br/>correctas · irrelevantes · incompletas · alucinadas · citas falsas"]

  title --> execution
  execution --> tests
